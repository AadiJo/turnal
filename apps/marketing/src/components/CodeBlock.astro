---
import CopyButton from './CopyButton.astro';

interface Props {
  code: string;
  label?: string;
  language?: string;
}

const { code, label = 'Terminal', language = 'shell' } = Astro.props;
---

<figure class="code-block">
  <figcaption>
    <span>{label}</span>
    <CopyButton text={code} label={`Copy ${label.toLowerCase()}`} />
  </figcaption>
  <pre><code class={`language-${language}`}>{code}</code></pre>
</figure>

<style>
  .code-block {
    margin: 1.4rem 0;
    overflow: hidden;
    border: 1px solid var(--hair);
    border-radius: 10px;
    background: var(--code-bg, #0c0b09);
  }

  figcaption {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 5px 6px 5px 16px;
    border-bottom: 1px solid var(--hair);
    color: var(--muted);
    font-family: var(--mono);
    font-size: 11px;
  }

  pre {
    margin: 0;
    padding: 18px 20px 20px;
    color: var(--code-fg, var(--fg));
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.7;
    tab-size: 2;
  }

  code {
    display: block;
    min-width: 0;
    font: inherit;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  @media (max-width: 620px) {
    pre {
      padding: 15px 14px 17px;
      font-size: 11.5px;
      line-height: 1.6;
    }
  }
</style>
