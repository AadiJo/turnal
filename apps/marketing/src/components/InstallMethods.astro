---
import CopyButton from './CopyButton.astro';
import { installMethods } from '../data/terminalHome';

interface Props {
  id: string;
  size?: 'default' | 'large';
}

const { id, size = 'default' } = Astro.props;
---

<div
  class:list={['install-methods', { 'install-methods-large': size === 'large' }]}
  data-install-methods
>
  <div class="install-method-tabs" role="tablist" aria-label="Install method">
    {installMethods.map((method, index) => (
      <button
        id={`${id}-tab-${method.id}`}
        type="button"
        role="tab"
        data-install-tab={index}
        data-install-label={method.label}
        aria-selected={index === 0 ? 'true' : 'false'}
        aria-controls={`${id}-command`}
        tabindex={index === 0 ? 0 : -1}
      >
        {method.label}
      </button>
    ))}
    <span class="install-method-indicator" aria-hidden="true"></span>
  </div>

  <div class="install-method-panel">
    <span class="install-prompt" aria-hidden="true">$</span>
    <div
      id={`${id}-command`}
      class="install-command-viewport"
      role="tabpanel"
      data-install-command-panel
      aria-labelledby={`${id}-tab-${installMethods[0].id}`}
    >
      {installMethods.map((method, index) => (
        <code data-install-command={index} title={method.command} hidden={index !== 0}>{method.command}</code>
      ))}
    </div>
    <CopyButton text={installMethods[0].command} label={`Copy ${installMethods[0].label} install command`} />
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-install-methods]').forEach((installMethods) => {
    const tabs = [...installMethods.querySelectorAll<HTMLButtonElement>('[data-install-tab]')];
    const commands = [...installMethods.querySelectorAll<HTMLElement>('[data-install-command]')];
    const commandPanel = installMethods.querySelector<HTMLElement>('[data-install-command-panel]');
    const copyButton = installMethods.querySelector<HTMLButtonElement>('.copybtn');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let activeIndex = 0;

    const select = (index: number, moveFocus = false) => {
      if (index === activeIndex) {
        if (moveFocus) tabs[index]?.focus();
        return;
      }

      const previousIndex = activeIndex;
      activeIndex = index;
      installMethods.style.setProperty('--install-method-index', String(index));
      tabs.forEach((tab, tabIndex) => {
        const selected = tabIndex === index;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        if (selected && moveFocus) tab.focus();
      });
      commands.forEach((command, commandIndex) => { command.hidden = commandIndex !== index; });

      const activeCommand = commands[index];
      const activeTab = tabs[index];
      if (commandPanel && activeTab) commandPanel.setAttribute('aria-labelledby', activeTab.id);
      if (copyButton && activeCommand && activeTab) {
        const copyLabel = `Copy ${activeTab.dataset.installLabel || 'selected'} install command`;
        copyButton.dataset.copy = activeCommand.textContent || '';
        copyButton.dataset.label = copyLabel;
        copyButton.setAttribute('aria-label', copyLabel);
        copyButton.classList.remove('copied');
      }

      if (!activeCommand || reduceMotion.matches) return;
      activeCommand.getAnimations().forEach((animation) => animation.cancel());
      activeCommand.animate([
        { opacity: 0, transform: `translateX(${index > previousIndex ? 8 : -8}px)` },
        { opacity: 1, transform: 'translateX(0)' },
      ], {
        duration: 180,
        easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(index));
      tab.addEventListener('keydown', (event) => {
        let next = index;
        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        select(next, true);
      });
    });
  });
</script>

<style>
  .install-methods {
    width: 650px;
    max-width: calc(100vw - 32px);
    flex: none;
    overflow: hidden;
    border: 1px solid var(--hair);
    border-radius: 12px;
    background: rgba(12, 11, 9, 0.78);
    box-shadow: inset 0 1px 0 rgba(236, 227, 212, 0.045);
    text-align: left;
  }

  .install-method-tabs {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-bottom: 1px solid var(--hair);
  }

  .install-method-tabs button {
    min-width: 0;
    padding: 10px 8px 9px;
    border: 0;
    background: transparent;
    color: var(--muted);
    font-size: 11.5px;
    font-weight: 580;
    white-space: nowrap;
    transition: background-color 160ms ease, color 160ms ease;
  }

  .install-method-tabs button:hover { background: rgba(236, 227, 212, 0.035); color: var(--fg); }
  .install-method-tabs button[aria-selected='true'] { color: var(--fg); }
  .install-method-tabs button:active { background: rgba(236, 227, 212, 0.055); }
  .install-method-tabs button:focus-visible { position: relative; outline: 2px solid var(--accent); outline-offset: -3px; }

  .install-method-indicator {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: calc(100% / 3);
    height: 2px;
    background: var(--accent);
    pointer-events: none;
    transform: translateX(calc(var(--install-method-index, 0) * 100%));
    transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .install-method-panel {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    min-height: 50px;
    align-items: center;
    gap: 10px;
    padding: 7px 7px 7px 15px;
    font-family: var(--mono);
    font-size: 12.5px;
  }

  .install-prompt { color: var(--accent); font-weight: 700; }
  .install-command-viewport { min-width: 0; overflow: hidden; }
  .install-command-viewport code {
    display: block;
    min-width: 0;
    overflow-x: auto;
    color: var(--fg);
    scrollbar-width: none;
    white-space: nowrap;
  }
  .install-command-viewport code[hidden] { display: none; }
  .install-command-viewport code::-webkit-scrollbar { display: none; }

  .install-methods-large .install-method-tabs button { padding-block: 11px 10px; font-size: 12px; }
  .install-methods-large .install-method-panel { min-height: 56px; padding: 9px 9px 9px 17px; font-size: 13.5px; }

  @media (max-width: 560px) {
    .install-method-tabs button { padding-inline: 4px; font-size: 10.5px; }
    .install-method-panel,
    .install-methods-large .install-method-panel {
      gap: 7px;
      padding-inline: 11px 7px;
      font-size: clamp(10.5px, 3.25vw, 12px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .install-method-indicator { transition: none; }
  }
</style>
