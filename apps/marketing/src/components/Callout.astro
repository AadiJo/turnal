---
interface Props {
  title: string;
  kind?: 'note' | 'warning' | 'tip';
}

const { title, kind = 'note' } = Astro.props;
---

<aside class:list={['callout', kind]}>
  <strong>{title}</strong>
  <div class="body"><slot /></div>
</aside>

<style>
  .callout {
    position: relative;
    margin: 24px 0;
    padding: 17px 18px 18px 20px;
    border: 1px solid var(--hair-strong);
    border-left: 3px solid var(--callout-accent, var(--accent));
    border-radius: 8px;
    background: rgba(236, 227, 212, 0.025);
  }

  .callout.warning { --callout-accent: #e8c15f; }
  .callout.tip { --callout-accent: #4bd695; }

  strong {
    display: block;
    margin-bottom: 5px;
    color: var(--fg);
    font-size: 14px;
    font-weight: 650;
  }

  .body {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.65;
  }

  .body :global(p + p) { margin-top: 8px; }
  .body :global(code) { font-size: 0.84em; }
</style>
