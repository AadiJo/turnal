---
// One source turn becomes a stable case, then fork preflight reveals its inputs.
---

<div class="cf-demo" data-case-fork aria-label="A source turn becoming an immutable case, followed by a fork readiness check">
  <div class="cf-toolbar">
    <p class="cf-command"><span>aadijo@MacBook-Pro Project %</span> turnal case create claude-a13f:4</p>
  </div>

  <div class="cf-stage" data-cf-stage>
    <section class="cf-source" aria-labelledby="cf-source-title">
      <header class="cf-node-head">
        <div>
          <p class="cf-kicker" id="cf-source-title">Source turn</p>
          <p class="cf-node-id">claude-a13f:4</p>
        </div>
      </header>

      <div class="cf-prompt">
        <span>prompt</span>
        <p>Make webhook delivery safe to retry.</p>
      </div>

      <dl class="cf-source-facts">
        <div><dt>checkpoint</dt><dd>8e7bc19</dd></div>
        <div><dt>workspace</dt><dd>3 files changed</dd></div>
        <div><dt>tests</dt><dd>13 passed</dd></div>
      </dl>
    </section>

    <div class="cf-transfer" aria-hidden="true">
      <span class="cf-transfer-line"></span>
      <span class="cf-packet cf-packet-a">turn</span>
      <span class="cf-packet cf-packet-b">base</span>
      <span class="cf-packet cf-packet-c">limits</span>
    </div>

    <section class="cf-case" aria-labelledby="cf-case-title">
      <span class="cf-case-edge" aria-hidden="true"></span>
      <header class="cf-node-head">
        <div>
          <p class="cf-kicker" id="cf-case-title">Case</p>
          <p class="cf-node-id">retry-webhook / rev 3</p>
        </div>
        <span class="cf-sealed">
          immutable
        </span>
      </header>

      <dl class="cf-case-facts">
        <div><dt>starting checkpoint</dt><dd>8e7bc19</dd></div>
        <div><dt>task revision</dt><dd>retry-webhook / 3</dd></div>
        <div><dt>contract</dt><dd>13 tests must pass</dd></div>
        <div><dt>limitations</dt><dd>staging API unavailable</dd></div>
      </dl>
    </section>

    <div class="cf-branch" aria-hidden="true">
      <span class="cf-branch-stem"></span>
    </div>

    <section class="cf-readiness" aria-labelledby="cf-readiness-title">
      <header class="cf-readiness-head">
        <div>
          <div>
            <p class="cf-kicker" id="cf-readiness-title">Fork preflight</p>
            <p class="cf-node-id">readiness only</p>
          </div>
        </div>
      </header>

      <p class="cf-fork-command"><span>aadijo@MacBook-Pro Project %</span> turnal fork claude-a13f:4 --dry-run</p>

      <div class="cf-readiness-groups">
        <section class="cf-ready-group cf-ready-group-have">
          <header><span aria-hidden="true"></span><h3>Captured</h3><small>3</small></header>
          <ul>
            <li style="--order: 0"><span>Base checkpoint</span><b>8e7bc19</b></li>
            <li style="--order: 1"><span>Instruction</span><b>exact</b></li>
            <li style="--order: 2"><span>Evaluators</span><b>13 tests</b></li>
          </ul>
        </section>

        <section class="cf-ready-group cf-ready-group-need">
          <header><span aria-hidden="true"></span><h3>Still needed</h3><small>3</small></header>
          <ul>
            <li style="--order: 0"><span>Conversation</span><b>partial</b></li>
            <li style="--order: 1"><span>Secrets</span><b>not captured</b></li>
            <li style="--order: 2"><span>Network</span><b>live service</b></li>
          </ul>
        </section>
      </div>
    </section>

    <div class="cf-storyline" aria-hidden="true">
      <p class="cf-story cf-story-one">Start with the turn that worked.</p>
      <p class="cf-story cf-story-two">Seal its starting point and constraints.</p>
      <p class="cf-story cf-story-three">See what a faithful fork would need.</p>
    </div>
  </div>

  <p class="cf-sr" role="status" aria-live="polite" data-cf-live></p>
</div>

<script>
  const demos = document.querySelectorAll<HTMLElement>('[data-case-fork]');

  demos.forEach((demo) => {
    const stage = demo.querySelector<HTMLElement>('[data-cf-stage]');
    const live = demo.querySelector<HTMLElement>('[data-cf-live]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (!stage || !live) return;

    let announceTimers: number[] = [];

    const clearAnnouncements = () => {
      announceTimers.forEach(window.clearTimeout);
      announceTimers = [];
    };

    const announceSequence = () => {
      clearAnnouncements();
      live.textContent = '';
      announceTimers.push(window.setTimeout(() => {
        live.textContent = 'The source turn is sealed as an immutable case.';
      }, 3200));
      announceTimers.push(window.setTimeout(() => {
        live.textContent = 'Fork preflight found three captured inputs and three inputs still needed.';
      }, 6900));
    };

    const settle = () => {
      clearAnnouncements();
      demo.classList.remove('is-running', 'is-paused');
      demo.classList.add('is-reduced');
      live.textContent = 'An immutable case is ready for fork preflight. Three inputs were captured and three are still needed.';
    };

    if (reducedMotion.matches) {
      settle();
      return;
    }

    demo.classList.add('is-running');
    announceSequence();

    const observer = new IntersectionObserver(([entry]) => {
      demo.classList.toggle('is-paused', !entry.isIntersecting);
      if (entry.isIntersecting) announceSequence();
      else clearAnnouncements();
    }, { threshold: 0.2 });
    observer.observe(stage);
  });
</script>

<style>
  .cf-demo {
    --cf-cycle: 11s;
    margin-top: 56px;
    border: 1px solid rgba(236, 227, 212, 0.14);
    background: #0d0c0b;
    color: #ece3d4;
    overflow: hidden;
  }

  .cf-toolbar {
    display: flex;
    min-height: 56px;
    align-items: center;
    padding: 0 18px;
    border-bottom: 1px solid rgba(236, 227, 212, 0.1);
  }

  .cf-command {
    margin: 0;
    color: rgba(236, 227, 212, 0.62);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 11px;
  }

  .cf-command span { color: rgba(236, 227, 212, 0.42); }

  .cf-stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(190px, 0.8fr) 72px minmax(230px, 0.95fr) 76px minmax(330px, 1.45fr);
    min-height: 430px;
    align-items: center;
    padding: 62px 30px 86px;
    isolation: isolate;
  }

  .cf-stage::before {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image:
      linear-gradient(rgba(236, 227, 212, 0.032) 1px, transparent 1px),
      linear-gradient(90deg, rgba(236, 227, 212, 0.032) 1px, transparent 1px);
    background-size: 40px 40px;
    content: '';
    mask-image: linear-gradient(to bottom, transparent, black 18%, black 82%, transparent);
  }

  .cf-source,
  .cf-case,
  .cf-readiness {
    position: relative;
    min-width: 0;
    border: 1px solid rgba(236, 227, 212, 0.13);
    background: rgba(20, 18, 16, 0.96);
  }

  .cf-source { z-index: 2; }
  .cf-case { z-index: 3; border-color: rgba(236, 227, 212, 0.18); }
  .cf-readiness { z-index: 2; }

  .cf-node-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    min-height: 67px;
    align-items: center;
    gap: 11px;
    padding: 0 14px;
    border-bottom: 1px solid rgba(236, 227, 212, 0.1);
  }

  .cf-kicker,
  .cf-node-id { margin: 0; }
  .cf-kicker { color: #ece3d4; font-size: 12px; font-weight: 650; line-height: 1.2; }
  .cf-node-id {
    margin-top: 4px;
    overflow: hidden;
    color: rgba(236, 227, 212, 0.45);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 8.5px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cf-sealed {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #e76d5b;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 8px;
  }
  .cf-sealed { opacity: 0; transform: translateY(-4px); }
  .cf-prompt { padding: 16px 14px 18px; }
  .cf-prompt span,
  .cf-source-facts dt,
  .cf-case-facts dt {
    color: rgba(236, 227, 212, 0.38);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 8px;
  }
  .cf-prompt p { margin: 8px 0 0; font-size: 12px; line-height: 1.45; }

  .cf-source-facts,
  .cf-case-facts { margin: 0; border-top: 1px solid rgba(236, 227, 212, 0.08); }
  .cf-source-facts > div,
  .cf-case-facts > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 34px;
    padding: 0 14px;
    border-bottom: 1px solid rgba(236, 227, 212, 0.065);
  }
  .cf-source-facts > div:last-child,
  .cf-case-facts > div:last-child { border-bottom: 0; }
  .cf-source-facts dd,
  .cf-case-facts dd {
    margin: 0;
    color: rgba(236, 227, 212, 0.7);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 8px;
    text-align: right;
  }

  .cf-case-facts > div { min-height: 39px; }
  .cf-case-edge {
    position: absolute;
    inset: -1px;
    z-index: -1;
    border: 1px solid rgba(240, 91, 43, 0.8);
    opacity: 0;
    pointer-events: none;
    transform: scale(1.035);
  }

  .cf-transfer,
  .cf-branch { position: relative; align-self: stretch; }
  .cf-transfer { --cf-lane: 72px; overflow: hidden; }
  .cf-transfer-line {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    background: rgba(236, 227, 212, 0.2);
    transform: scaleX(0);
    transform-origin: left;
  }
  .cf-packet {
    position: absolute;
    top: calc(50% - 9px);
    left: 0;
    z-index: 4;
    padding: 4px 5px;
    border: 1px solid rgba(236, 227, 212, 0.2);
    background: #0d0c0b;
    color: rgba(236, 227, 212, 0.62);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 6px;
    opacity: 0;
    transform: translateX(-100%);
  }
  .cf-readiness-head {
    display: flex;
    min-height: 67px;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 0 15px;
    border-bottom: 1px solid rgba(236, 227, 212, 0.1);
  }
  .cf-readiness-head > div { display: flex; align-items: center; gap: 11px; min-width: 0; }
  .cf-fork-command {
    min-width: 0;
    margin: 0;
    padding: 12px 15px;
    overflow: hidden;
    border-bottom: 1px solid rgba(236, 227, 212, 0.1);
    color: rgba(236, 227, 212, 0.68);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 8px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cf-fork-command span { color: rgba(236, 227, 212, 0.4); }

  .cf-readiness-groups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .cf-ready-group:first-child { border-right: 1px solid rgba(236, 227, 212, 0.1); }
  .cf-ready-group header {
    display: grid;
    grid-template-columns: auto 1fr auto;
    min-height: 46px;
    align-items: center;
    gap: 8px;
    padding: 0 12px;
    border-bottom: 1px solid rgba(236, 227, 212, 0.08);
  }
  .cf-ready-group header > span { width: 6px; height: 6px; border-radius: 50%; background: #8e9a81; }
  .cf-ready-group-need header > span { border: 1px solid rgba(236, 227, 212, 0.34); background: transparent; }
  .cf-ready-group h3 { margin: 0; color: rgba(236, 227, 212, 0.8); font-size: 10px; font-weight: 600; }
  .cf-ready-group small { color: rgba(236, 227, 212, 0.34); font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 8px; }
  .cf-ready-group ul { margin: 0; padding: 0; list-style: none; }
  .cf-ready-group li {
    display: flex;
    min-height: 42px;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 0 12px;
    border-bottom: 1px solid rgba(236, 227, 212, 0.065);
    opacity: 0;
    transform: translateY(7px);
  }
  .cf-ready-group li:last-child { border-bottom: 0; }
  .cf-ready-group li span { color: rgba(236, 227, 212, 0.64); font-size: 8.5px; }
  .cf-ready-group li b { color: rgba(236, 227, 212, 0.38); font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 7px; font-weight: 400; text-align: right; }
  .cf-ready-group-need li { border-left: 1px dashed rgba(236, 227, 212, 0.11); }

  .cf-branch-stem {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    background: rgba(236, 227, 212, 0.18);
    transform: scaleX(0);
    transform-origin: left;
  }

  .cf-storyline {
    position: absolute;
    right: 30px;
    bottom: 27px;
    left: 30px;
    height: 18px;
    color: rgba(236, 227, 212, 0.88);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-align: center;
  }
  .cf-story { position: absolute; inset: 0; margin: 0; opacity: 0; }

  .cf-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .is-running .cf-source { animation: cf-source var(--cf-cycle) ease-in-out infinite; }
  .is-running .cf-transfer-line { animation: cf-line var(--cf-cycle) ease-in-out infinite; }
  .is-running .cf-packet-a { animation: cf-packet var(--cf-cycle) ease-in-out infinite; }
  .is-running .cf-packet-b { animation: cf-packet var(--cf-cycle) 0.62s ease-in-out infinite; }
  .is-running .cf-packet-c { animation: cf-packet var(--cf-cycle) 1.24s ease-in-out infinite; }
  .is-running .cf-case { animation: cf-case var(--cf-cycle) ease-in-out infinite; }
  .is-running .cf-case-edge { animation: cf-seal-edge var(--cf-cycle) ease-out infinite; }
  .is-running .cf-sealed { animation: cf-sealed var(--cf-cycle) ease-out infinite; }
  .is-running .cf-branch-stem { animation: cf-stem var(--cf-cycle) ease-out infinite; }
  .is-running .cf-ready-group li { animation: cf-item var(--cf-cycle) ease-out infinite; animation-delay: calc(var(--order) * 90ms); }
  .is-running .cf-ready-group-need li { animation-name: cf-need-item; }
  .is-running .cf-story-one { animation: cf-story-one var(--cf-cycle) ease-in-out infinite; }
  .is-running .cf-story-two { animation: cf-story-two var(--cf-cycle) ease-in-out infinite; }
  .is-running .cf-story-three { animation: cf-story-three var(--cf-cycle) ease-in-out infinite; }

  .is-paused *,
  .is-paused *::before,
  .is-paused *::after { animation-play-state: paused !important; }

  @keyframes cf-source {
    0% { opacity: 0; transform: translateY(9px); }
    5%, 18% { opacity: 1; transform: translateY(0); }
    28%, 92% { opacity: 0.46; transform: translateY(0); }
    100% { opacity: 0; transform: translateY(9px); }
  }
  @keyframes cf-line { 0%, 11% { transform: scaleX(0); } 19%, 88% { transform: scaleX(1); } 94%, 100% { transform: scaleX(0); } }
  @keyframes cf-packet {
    0%, 10% { opacity: 0; transform: translateX(-100%); }
    11% { opacity: 1; transform: translateX(-100%); }
    15% { opacity: 1; transform: translateX(calc(var(--cf-lane) - 100%)); }
    16%, 100% { opacity: 0; transform: translateX(var(--cf-lane)); }
  }
  @keyframes cf-case { 0%, 16% { opacity: 0.34; transform: scale(0.985); } 24%, 92% { opacity: 1; transform: scale(1); } 100% { opacity: 0.34; transform: scale(0.985); } }
  @keyframes cf-seal-edge { 0%, 21% { opacity: 0; transform: scale(1.04); } 24% { opacity: 0.9; transform: scale(1); } 29% { opacity: 0.22; transform: scale(1); } 35%, 100% { opacity: 0; transform: scale(1); } }
  @keyframes cf-sealed { 0%, 22% { opacity: 0; transform: translateY(-4px); } 27%, 92% { opacity: 1; transform: translateY(0); } 100% { opacity: 0; transform: translateY(-4px); } }
  @keyframes cf-stem { 0%, 31% { transform: scaleX(0); } 38%, 91% { transform: scaleX(1); } 100% { transform: scaleX(0); } }
  @keyframes cf-item { 0%, 44% { opacity: 0; transform: translateY(7px); } 52%, 92% { opacity: 1; transform: translateY(0); } 100% { opacity: 0; transform: translateY(7px); } }
  @keyframes cf-need-item { 0%, 51% { opacity: 0; transform: translateY(7px); } 59%, 92% { opacity: 0.62; transform: translateY(0); } 100% { opacity: 0; transform: translateY(7px); } }
  @keyframes cf-story-one { 0%, 3% { opacity: 0; transform: translateY(4px); } 7%, 16% { opacity: 1; transform: translateY(0); } 21%, 100% { opacity: 0; transform: translateY(-4px); } }
  @keyframes cf-story-two { 0%, 19% { opacity: 0; transform: translateY(4px); } 25%, 34% { opacity: 1; transform: translateY(0); } 39%, 100% { opacity: 0; transform: translateY(-4px); } }
  @keyframes cf-story-three { 0%, 42% { opacity: 0; transform: translateY(4px); } 49%, 88% { opacity: 1; transform: translateY(0); } 94%, 100% { opacity: 0; transform: translateY(-4px); } }

  .is-reduced .cf-source { opacity: 0.46; }
  .is-reduced .cf-transfer-line,
  .is-reduced .cf-branch-stem { transform: scaleX(1); }
  .is-reduced .cf-case,
  .is-reduced .cf-sealed,
  .is-reduced .cf-ready-group li,
  .is-reduced .cf-story-three { opacity: 1; transform: none; }
  .is-reduced .cf-ready-group-need li { opacity: 0.62; }

  @media (max-width: 1040px) {
    .cf-stage { grid-template-columns: minmax(175px, 0.8fr) 48px minmax(210px, 1fr) 50px minmax(280px, 1.35fr); padding-inline: 22px; }
    .cf-transfer { --cf-lane: 48px; }
  }

  @media (max-width: 820px) {
    .cf-stage {
      grid-template-columns: minmax(0, 1fr);
      gap: 42px;
      padding: 38px 18px 82px;
    }
    .cf-source,
    .cf-case,
    .cf-readiness { width: 100%; max-width: 520px; margin-inline: auto; }
    .cf-transfer,
    .cf-branch { position: absolute; left: 50%; width: 1px; height: 42px; align-self: auto; transform: translateX(-50%); }
    .cf-packet { display: none; }
    .cf-transfer { top: 249px; }
    .cf-branch { top: 531px; }
    .cf-transfer-line,
    .cf-branch-stem { top: 0; width: 1px; height: 100%; transform: scaleY(0); transform-origin: top; }
    .is-running .cf-transfer-line { animation-name: cf-line-mobile; }
    .is-running .cf-branch-stem { animation-name: cf-stem-mobile; }
    .is-reduced .cf-transfer-line,
    .is-reduced .cf-branch-stem { transform: scaleY(1); }
    .cf-storyline { right: 18px; left: 18px; }
    @keyframes cf-line-mobile { 0%, 11% { transform: scaleY(0); } 19%, 88% { transform: scaleY(1); } 94%, 100% { transform: scaleY(0); } }
    @keyframes cf-stem-mobile { 0%, 31% { transform: scaleY(0); } 38%, 91% { transform: scaleY(1); } 100% { transform: scaleY(0); } }
  }

  @media (max-width: 560px) {
    .cf-demo { margin-top: 42px; }
    .cf-toolbar { padding-inline: 12px; }
    .cf-command { max-width: calc(100% - 80px); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .cf-stage { padding-inline: 12px; }
    .cf-readiness-groups { grid-template-columns: 1fr; }
    .cf-ready-group:first-child { border-right: 0; border-bottom: 1px solid rgba(236, 227, 212, 0.1); }
    .cf-transfer { top: 249px; }
    .cf-branch { top: 531px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cf-demo *,
    .cf-demo *::before,
    .cf-demo *::after { animation: none !important; transition: none !important; }
  }
</style>
