---
// Header call-to-action linking to the repo. Inherits the surrounding theme's
// --fg / --hair custom properties, so it works on both the home and docs headers.
import { product } from '../data/content';

interface Props {
  label?: string;
}

const { label = 'Star on GitHub' } = Astro.props;
---

<a
  class="star-cta"
  href={`https://${product.repo}`}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
>
  <svg class="star-cta-mark" viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true">
    <path
      fill-rule="evenodd"
      d="M8 0C3.58 0 0 3.58 0 8C0 11.54 2.29 14.53 5.47 15.59C5.87 15.66 6.02 15.42 6.02 15.21C6.02 15.02 6.01 14.39 6.01 13.72C4 14.09 3.48 13.23 3.32 12.78C3.23 12.55 2.84 11.84 2.5 11.65C2.22 11.5 1.82 11.13 2.49 11.12C3.12 11.11 3.57 11.7 3.72 11.94C4.44 13.15 5.59 12.81 6.05 12.6C6.12 12.08 6.33 11.73 6.56 11.53C4.78 11.33 2.92 10.64 2.92 7.58C2.92 6.71 3.23 5.99 3.74 5.43C3.66 5.23 3.38 4.41 3.82 3.31C3.82 3.31 4.49 3.1 6.02 4.13C6.66 3.95 7.34 3.86 8.02 3.86C8.7 3.86 9.38 3.95 10.02 4.13C11.55 3.09 12.22 3.31 12.22 3.31C12.66 4.41 12.38 5.23 12.3 5.43C12.81 5.99 13.12 6.7 13.12 7.58C13.12 10.65 11.25 11.33 9.47 11.53C9.76 11.78 10.01 12.26 10.01 13.01C10.01 14.08 10 14.94 10 15.21C10 15.42 10.15 15.67 10.55 15.59C13.71 14.53 16 11.53 16 8C16 3.58 12.42 0 8 0Z"
    />
  </svg>
  <span>{label}</span>
  <svg class="star-cta-star" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
    <path
      d="M8 1.6l1.86 3.9 4.14.6-3 3.02.71 4.28L8 11.38l-3.71 2.02.71-4.28-3-3.02 4.14-.6z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linejoin="round"
    />
  </svg>
</a>

<style>
  .star-cta {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 8px;
    padding: 8px 13px;
    border: 1px solid var(--hair, rgba(236, 227, 212, 0.11));
    border-radius: 10px;
    background: rgba(236, 227, 212, 0.035);
    color: var(--fg, #ece3d4);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
    white-space: nowrap;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      transform 120ms ease;
  }
  .star-cta:hover,
  .star-cta:focus-visible {
    border-color: rgba(236, 227, 212, 0.22);
    background: rgba(236, 227, 212, 0.09);
  }
  .star-cta:active { transform: scale(0.98); }

  .star-cta-mark { flex: none; }
  .star-cta-star {
    flex: none;
    color: rgba(236, 227, 212, 0.5);
    transition: color 160ms ease, fill 160ms ease;
  }
  .star-cta:hover .star-cta-star,
  .star-cta:focus-visible .star-cta-star { color: #ffb224; }
  /* CSS wins over the path's fill="none" presentation attribute. */
  .star-cta:hover .star-cta-star path,
  .star-cta:focus-visible .star-cta-star path { fill: currentColor; }

  @media (max-width: 560px) {
    .star-cta { gap: 7px; padding: 8px 11px; }
    .star-cta span { display: none; }
    .star-cta-star { display: none; }
  }
</style>
