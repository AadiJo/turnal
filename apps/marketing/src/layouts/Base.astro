---
import '../styles/base.css';

interface Props {
  title?: string;
  description?: string;
  theme?: string; // maps to a body class for page-level palettes
}
const {
  title = 'Turnal — a flight recorder for your AI coding agent',
  description = 'Turnal records every turn your AI agent takes — the prompt, the tool calls, the file changes — as hidden Git checkpoints. Understand it, search it, and roll back safely. Local-first, zero config.',
  theme,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={theme}>
    <slot />
  </body>
</html>
