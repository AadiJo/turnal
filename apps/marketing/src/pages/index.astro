---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import CopyButton from '../components/CopyButton.astro';
import PolishedTerminal from '../components/PolishedTerminal.astro';
import TurnalWorkflow from '../components/TurnalWorkflow.astro';
import SnapshotComparison from '../components/SnapshotComparison.astro';
import AgentHistoryDemo from '../components/AgentHistoryDemo.astro';
import CaseForkDemo from '../components/CaseForkDemo.astro';
import { commandPanels, graphOutput, installCommand } from '../data/terminalHome';
import { product } from '../data/content';
import prismScreenshotUrl from '../../../../docs/turnal-viewer-sessions.png?url';

const capabilities = [
  {
    title: 'Local by construction.',
    body: 'Events and checkpoints live in ',
    code: '.turnal',
    bodyTail: ', outside your Git history.',
  },
  {
    title: 'One history across agents.',
    body: 'Completed turns from every agent land in one traceable timeline.',
  },
  {
    title: 'The story behind the diff.',
    body: 'Prompts, responses, tools, and file changes stay together for every turn.',
  },
  {
    title: 'Recovery you can rehearse.',
    body: 'Preview the rollback. Turnal saves a safety checkpoint first.',
  },
];

---

<Base
  theme="terminal-home-theme"
  title="Turnal - local history for AI coding agents"
  description="Turnal preserves Claude Code and Codex turns as local checkpoints you can search, diff, verify, and roll back safely."
>
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <a class="skip-link" href="#main-content">Skip to content</a>

  <div class="terminal-home-page">
    <header class="site-nav">
      <div class="th-wrap nav-row">
        <a class="nav-brand" href="#top" aria-label="Turnal home"><Logo size={27} /></a>
        <nav class="nav-links" aria-label="Primary navigation">
          <a href="/docs">Docs</a>
          <a href={`https://${product.repo}`} target="_blank" rel="noopener noreferrer">GitHub</a>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <section id="top" class="hero th-wrap">
        <div class="hero-intro">
          <h1>Every agent turn,<span>on the record.</span></h1>

          <div class="hero-copy">
            <p>Turnal pairs agent activity with byte-exact workspace checkpoints. Search what happened, trace a line to the agent’s stated intent and human request, verify an earlier state, and roll back with a safety net, all on your machine.</p>

            <div class="hero-actions">
              <div class="install-command" id="install">
                <span>$</span>
                <code>{installCommand}</code>
                <CopyButton text={installCommand} />
              </div>
              <a class="extension-install" href="https://marketplace.visualstudio.com/items?itemName=aadijo.turnal-vscode">
                <img src="/brands/vscode.svg" alt="" width="18" height="18" aria-hidden="true" />
                <strong>Get the extension <span aria-hidden="true">→</span></strong>
              </a>
              <a class="docs-link" href="/docs">Read the docs <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </div>

        <div class="hero-visual" aria-label="Interleaved Turnal checkpoint history">
          <PolishedTerminal
            title=""
            prompt="aadijo@MacBook-Pro Project %"
            command="turnal log --all-worktrees --no-pager"
            output={graphOutput}
            size="hero"
          />
        </div>
      </section>

      <section class="adapter-strip th-wrap" aria-label="Supported coding agents">
        <img src="/brands/claude.svg" alt="Claude Code" width="34" height="34" />
        <img src="/brands/codex.svg" alt="Codex" width="34" height="34" />
      </section>

      <section id="features" class="capabilities th-wrap">
        <header class="section-heading">
          <h2>It watches the work. It doesn’t direct it.</h2>
          <p>An append-only event trail explains what happened. Hidden Git checkpoints preserve what the captured workspace looked like. Turnal keeps the two together.</p>
        </header>

        <div class="capability-ledger">
          {capabilities.map((capability) => (
            <article>
              <h3>{capability.title}</h3>
              <p>{capability.body}{capability.code && <><code>{capability.code}</code>{capability.bodyTail}</>}</p>
            </article>
          ))}
        </div>
      </section>

      <AgentHistoryDemo />

      <section id="difference" class="compare-section th-wrap">
        <header class="section-heading">
          <h2>A commit shows the code. An agent turn shows the story.</h2>
          <p>A Git commit preserves what the code looked like. An agent turn adds what happened, the problem the agent said it was solving, the human request, what changed, and how to get back safely.</p>
        </header>

        <SnapshotComparison />
      </section>

      <section id="how" class="workflow-section th-wrap">
        <header class="workflow-heading">
          <h2>Capture. Inspect. Verify. Recover.</h2>
          <p>Search, diff, blame, verification, and rollback all derive from events and checkpoints already on disk.</p>
        </header>
        <TurnalWorkflow />
      </section>

      <section class="commands-section th-wrap">
        <header class="commands-heading">
          <h2>Go beyond the timeline.</h2>
          <p>Trace a line, test an earlier state, name a rollback point, inspect rerun readiness, or preserve a turn as an immutable case.</p>
        </header>

        <div class="command-workbench" data-command-workbench>
          <div class="command-menu" role="tablist" aria-label="Turnal commands" aria-orientation="vertical">
            {commandPanels.map((panel, index) => (
              <button
                id={`command-tab-${panel.id}`}
                type="button"
                role="tab"
                data-command-tab={index}
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-controls={`command-panel-${panel.id}`}
                tabindex={index === 0 ? 0 : -1}
              >
                <code>{panel.label}</code>
                <span>{panel.description}</span>
              </button>
            ))}
          </div>

          <div class="command-panels">
            {commandPanels.map((panel, index) => (
              <div
                id={`command-panel-${panel.id}`}
                role="tabpanel"
                data-command-panel={index}
                aria-labelledby={`command-tab-${panel.id}`}
                hidden={index !== 0}
              >
                <PolishedTerminal
                  title=""
                  prompt="aadijo@MacBook-Pro Project %"
                  command={panel.command}
                  output={panel.output}
                  size="panel"
                />
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="prism" class="prism-section th-wrap" aria-labelledby="prism-title">
        <header class="section-heading">
          <h2 id="prism-title">Every project. One local view.</h2>
          <p>Run <code>turnal ui</code> to see sessions from Claude Code and Codex in one place. Open a project to review its prompts, models, turns, branches, and file changes.</p>
        </header>

        <figure class="prism-frame">
          <img
            src={prismScreenshotUrl}
            alt="Turnal Prism session list for the example atlas-web project, with claude-fable-5 and gpt-5.6-sol sessions"
            width="1440"
            height="418"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </section>

      <section id="evidence" class="evidence-section th-wrap">
        <header class="section-heading">
          <h2>Keep the starting point. See what a fork needs.</h2>
          <p>When a result deserves another pass, preserve its starting point as a case. Fork preflight shows what you need to retry the task with a different agent, instruction, or approach.</p>
        </header>

        <CaseForkDemo />
      </section>

      <section class="final-cta">
        <div class="th-wrap final-cta-inner">
          <h2>Keep the story next to the code.</h2>
          <p>Install Turnal, initialize the workspace, then let Claude Code and Codex work normally.</p>
          <div class="install-command install-command-large">
            <span>$</span>
            <code>{installCommand}</code>
            <CopyButton text={installCommand} />
          </div>
          <a class="extension-install extension-install-large" href="https://marketplace.visualstudio.com/items?itemName=aadijo.turnal-vscode">
            <img src="/brands/vscode.svg" alt="" width="18" height="18" aria-hidden="true" />
            <strong>Get the extension <span aria-hidden="true">→</span></strong>
          </a>
          <div class="final-links">
            <a href="/docs">Read the docs</a>
            <a href={`https://${product.repo}`}>View on GitHub</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="th-wrap footer-row">
        <Logo size={22} />
        <span>Apache-2.0</span>
        <a href={`https://${product.repo}`}>{product.repo}</a>
      </div>
    </footer>
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-command-workbench]').forEach((workbench) => {
    const tabs = [...workbench.querySelectorAll<HTMLButtonElement>('[data-command-tab]')];
    const panels = [...workbench.querySelectorAll<HTMLElement>('[data-command-panel]')];

    const select = (index: number, moveFocus = false) => {
      tabs.forEach((tab, tabIndex) => {
        const selected = tabIndex === index;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        if (selected && moveFocus) tab.focus();
      });
      panels.forEach((panel, panelIndex) => { panel.hidden = panelIndex !== index; });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(index));
      tab.addEventListener('keydown', (event) => {
        let next = index;
        if (event.key === 'ArrowDown' || event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        select(next, true);
      });
    });
  });

  const heroTerminal = document.querySelector<HTMLElement>('.hero-visual .polished-terminal');
  const heroIntro = document.querySelector<HTMLElement>('.hero-intro');
  const desktopHero = window.matchMedia('(min-width: 821px)');

  if (heroTerminal && heroIntro) {
    const terminalBar = heroTerminal.querySelector<HTMLElement>('.pt-bar');
    const terminalBody = heroTerminal.querySelector<HTMLElement>('.pt-body');
    const terminalCode = terminalBody?.querySelector<HTMLElement>('code');
    const syncHeroTerminalHeight = () => {
      if (!desktopHero.matches || !terminalBar || !terminalBody || !terminalCode) {
        heroTerminal.style.removeProperty('--pt-hero-body-height');
        heroTerminal.style.removeProperty('--pt-hero-line-shift');
        return;
      }

      const viewportHeight = document.documentElement.clientHeight;
      const terminalTop = heroTerminal.getBoundingClientRect().top;
      const overshoot = Math.max(112, Math.min(156, viewportHeight * 0.115));
      heroTerminal.style.setProperty('--pt-hero-line-shift', '0px');
      let bodyStyle = window.getComputedStyle(terminalBody);
      const codeStyle = window.getComputedStyle(terminalCode);
      const lineHeight = Number.parseFloat(codeStyle.lineHeight);
      const basePaddingTop = Number.parseFloat(bodyStyle.paddingTop);
      const foldOffset = viewportHeight - terminalTop - terminalBar.offsetHeight - basePaddingTop;
      const foldRemainder = ((foldOffset % lineHeight) + lineHeight) % lineHeight;
      const lineShift = foldRemainder - lineHeight / 2;
      heroTerminal.style.setProperty('--pt-hero-line-shift', `${lineShift.toFixed(2)}px`);
      bodyStyle = window.getComputedStyle(terminalBody);
      const verticalPadding = Number.parseFloat(bodyStyle.paddingTop) + Number.parseFloat(bodyStyle.paddingBottom);
      const contentHeight = Math.ceil(terminalCode.scrollHeight + verticalPadding);
      const foldHeight = viewportHeight + overshoot - terminalTop - terminalBar.offsetHeight;
      const bodyHeight = Math.min(contentHeight, Math.max(600, foldHeight));
      heroTerminal.style.setProperty('--pt-hero-body-height', `${Math.ceil(bodyHeight)}px`);
    };

    const heroObserver = new ResizeObserver(syncHeroTerminalHeight);
    heroObserver.observe(document.documentElement);
    heroObserver.observe(heroIntro);
    desktopHero.addEventListener('change', syncHeroTerminalHeight);
    void document.fonts.ready.then(syncHeroTerminalHeight);
    syncHeroTerminalHeight();

    window.addEventListener('pagehide', () => {
      heroObserver.disconnect();
      desktopHero.removeEventListener('change', syncHeroTerminalHeight);
    }, { once: true });
  }
</script>

<style is:global>
  .terminal-home-theme {
    --accent: #ff4f00;
    --bg: #100f0d;
    --surface: #17130f;
    --surface-strong: #0c0b09;
    --fg: #ece3d4;
    --muted: rgba(236, 227, 212, 0.58);
    --soft: rgba(236, 227, 212, 0.08);
    --hair: rgba(236, 227, 212, 0.11);
    --copy-bg: rgba(236, 227, 212, 0.08);
    --copy-fg: rgba(236, 227, 212, 0.58);
    min-height: 100dvh;
    background: var(--bg);
    color: var(--fg);
  }

  .terminal-home-theme .terminal-home-page { min-height: 100dvh; overflow: clip; }
  .terminal-home-theme .th-wrap { width: min(100%, 1240px); margin-inline: auto; padding-inline: 28px; }

  .terminal-home-theme .skip-link {
    position: fixed;
    z-index: 80;
    top: 10px;
    left: 10px;
    padding: 9px 12px;
    transform: translateY(-160%);
    border-radius: 8px;
    background: var(--fg);
    color: var(--bg);
    font-weight: 600;
  }
  .terminal-home-theme .skip-link:focus { transform: translateY(0); }

  .terminal-home-theme .site-nav {
    position: sticky;
    z-index: 40;
    top: 0;
    border-bottom: 1px solid var(--hair);
    background: rgba(16, 15, 13, 0.76);
    backdrop-filter: blur(16px);
  }
  .terminal-home-theme .nav-row { display: flex; height: 68px; align-items: center; gap: 26px; }
  .terminal-home-theme .nav-brand { flex: none; color: var(--fg); }
  .terminal-home-theme .nav-links { display: flex; margin-left: auto; align-items: center; gap: 28px; color: var(--muted); font-size: 13px; font-weight: 500; }
  .terminal-home-theme .nav-links a,
  .terminal-home-theme .nav-install,
  .terminal-home-theme .docs-link,
  .terminal-home-theme .final-links a,
  .terminal-home-theme .site-footer a { transition: color 160ms ease, background-color 160ms ease, transform 120ms ease; }
  .terminal-home-theme .nav-links a:hover,
  .terminal-home-theme .nav-links a:focus-visible { color: var(--fg); }
  .terminal-home-theme .nav-install {
    flex: none;
    padding: 9px 14px;
    border: 1px solid var(--hair);
    border-radius: 10px;
    color: var(--fg);
    font-size: 12.5px;
    font-weight: 600;
  }
  .terminal-home-theme .nav-install:hover { background: rgba(236, 227, 212, 0.06); }
  .terminal-home-theme .nav-install:active { transform: scale(0.98); }

  .terminal-home-theme .hero {
    min-height: 0;
    padding-top: 60px;
    padding-bottom: 22px;
  }
  .terminal-home-theme .hero-intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    text-align: center;
  }
  .terminal-home-theme .hero h1 { max-width: 13ch; margin: 0; font-size: clamp(48px, 5vw, 70px); font-weight: 660; letter-spacing: -0.052em; line-height: 0.96; text-wrap: balance; }
  .terminal-home-theme .hero h1 span { display: block; color: rgba(236, 227, 212, 0.48); }
  .terminal-home-theme .hero-copy { display: flex; max-width: 650px; flex-direction: column; align-items: center; }
  .terminal-home-theme .hero-copy > p { max-width: 58ch; margin: 0; color: var(--muted); font-size: 15.5px; line-height: 1.58; text-wrap: pretty; }

  .terminal-home-theme .hero-actions { display: flex; margin-top: 22px; flex-wrap: wrap; align-items: center; justify-content: center; gap: 16px; }
  .terminal-home-theme .install-command {
    display: inline-flex;
    height: 50px;
    max-width: 100%;
    box-sizing: border-box;
    align-items: center;
    gap: 10px;
    padding: 7px 7px 7px 15px;
    border: 1px solid var(--hair);
    border-radius: 12px;
    background: rgba(12, 11, 9, 0.78);
    box-shadow: inset 0 1px 0 rgba(236, 227, 212, 0.045);
    font-family: var(--mono);
    font-size: 12.5px;
  }
  .terminal-home-theme .install-command > span { color: var(--accent); font-weight: 700; }
  .terminal-home-theme .install-command code { min-width: 0; overflow: hidden; color: var(--fg); text-overflow: ellipsis; white-space: nowrap; }
  .terminal-home-theme .extension-install {
    display: inline-flex;
    width: auto;
    height: 50px;
    box-sizing: border-box;
    align-items: center;
    gap: 10px;
    padding: 8px 13px;
    border: 1px solid var(--hair);
    border-radius: 12px;
    background: rgba(236, 227, 212, 0.035);
    color: var(--muted);
    font-size: 12px;
    transition: background-color 160ms ease, color 160ms ease, transform 120ms ease;
  }
  .terminal-home-theme .extension-install > img { width: 18px; height: 18px; flex: none; object-fit: contain; }
  .terminal-home-theme .extension-install strong { color: var(--fg); font-weight: 600; }
  .terminal-home-theme .extension-install:hover { background: rgba(236, 227, 212, 0.065); color: var(--fg); transform: translateY(-1px); }
  .terminal-home-theme .extension-install:active { transform: scale(0.98); }
  .terminal-home-theme .docs-link { color: var(--muted); font-size: 13px; font-weight: 600; white-space: nowrap; }
  .terminal-home-theme .docs-link:hover { color: var(--fg); transform: translateX(2px); }

  .terminal-home-theme .hero-visual { min-width: 0; margin-top: 34px; }

  .terminal-home-theme .adapter-strip {
    display: flex;
    min-height: 78px;
    align-items: center;
    justify-content: center;
    gap: 32px;
    border-top: 1px solid var(--hair);
    border-bottom: 1px solid var(--hair);
  }
  .terminal-home-theme .adapter-strip img { width: 30px; height: 30px; object-fit: contain; opacity: 0.65; filter: saturate(0.55); transition: opacity 160ms ease, filter 160ms ease; }
  .terminal-home-theme .adapter-strip img:hover { opacity: 1; filter: none; }

  .terminal-home-theme .capabilities { padding-top: 145px; padding-bottom: 74px; scroll-margin-top: 82px; }
  .terminal-home-theme .section-heading { max-width: 700px; }
  .terminal-home-theme .section-heading h2,
  .terminal-home-theme .workflow-heading h2,
  .terminal-home-theme .commands-heading h2,
  .terminal-home-theme .final-cta h2 { margin: 0; font-size: clamp(34px, 4vw, 54px); font-weight: 650; letter-spacing: -0.045em; line-height: 1; text-wrap: balance; }
  .terminal-home-theme .section-heading > p:last-child,
  .terminal-home-theme .workflow-heading p,
  .terminal-home-theme .commands-heading p,
  .terminal-home-theme .final-cta-inner > p { max-width: 60ch; margin-top: 18px; color: var(--muted); font-size: 15.5px; line-height: 1.6; }

  .terminal-home-theme .capability-ledger {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 54px;
    border-top: 1px solid var(--hair);
    border-bottom: 1px solid var(--hair);
  }
  .terminal-home-theme .capability-ledger article {
    display: flex;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    flex-direction: column;
    justify-content: center;
    padding: 48px 26px;
    border-right: 1px solid var(--hair);
  }
  .terminal-home-theme .capability-ledger article:last-child { border-right: 0; }
  .terminal-home-theme .capability-ledger h3 { margin-top: 0; font-size: 18px; font-weight: 620; letter-spacing: -0.025em; line-height: 1.18; }
  .terminal-home-theme .capability-ledger p { margin-top: 11px; color: var(--muted); font-size: 13.5px; line-height: 1.55; }
  .terminal-home-theme .capability-ledger code {
    padding: 0.08em 0.28em;
    border: 1px solid rgba(236, 227, 212, 0.14);
    border-radius: 4px;
    background: rgba(236, 227, 212, 0.05);
    color: var(--fg);
    font-family: var(--mono);
    font-size: 0.88em;
    white-space: nowrap;
  }

  .terminal-home-theme .prism-section {
    padding-top: 70px;
    padding-bottom: 126px;
    scroll-margin-top: 82px;
  }
  .terminal-home-theme .prism-section code {
    color: var(--fg);
    font-family: var(--mono);
    font-size: 0.9em;
  }
  .terminal-home-theme .prism-frame {
    margin: 50px 0 0;
  }
  .terminal-home-theme .prism-frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  .terminal-home-theme .evidence-section { padding-top: 112px; padding-bottom: 118px; border-top: 1px solid var(--hair); scroll-margin-top: 82px; }

  .terminal-home-theme .workflow-section { padding-top: 104px; padding-bottom: 104px; scroll-margin-top: 82px; }
  .terminal-home-theme .workflow-heading { max-width: 660px; margin-bottom: 24px; }

  .terminal-home-theme .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .terminal-home-theme .compare-section { padding-top: 24px; padding-bottom: 112px; }
  .terminal-home-theme .commands-section { padding-top: 104px; padding-bottom: 112px; border-top: 1px solid var(--hair); }
  .terminal-home-theme .commands-heading { max-width: 710px; margin-bottom: 48px; }
  .terminal-home-theme .command-workbench { display: grid; grid-template-columns: minmax(250px, 0.72fr) minmax(0, 1.62fr); gap: 30px; align-items: stretch; }
  .terminal-home-theme .command-menu { min-width: 0; padding-right: 8px; }
  .terminal-home-theme .command-menu button {
    display: block;
    width: 100%;
    padding: 18px 14px;
    border: 0;
    border-bottom: 1px solid var(--hair);
    background: transparent;
    color: var(--muted);
    text-align: left;
    outline: none;
    transition: background-color 160ms ease, color 160ms ease, transform 120ms ease;
  }
  .terminal-home-theme .command-menu button:hover { color: var(--fg); background: rgba(236, 227, 212, 0.025); }
  .terminal-home-theme .command-menu button:active { transform: scale(0.99); }
  .terminal-home-theme .command-menu button:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .terminal-home-theme .command-menu button[aria-selected='true'] { color: var(--fg); background: rgba(236, 227, 212, 0.045); }
  .terminal-home-theme .command-menu code { display: block; color: inherit; font-family: var(--mono); font-size: 12px; font-weight: 600; }
  .terminal-home-theme .command-menu button[aria-selected='true'] code { color: #ff7040; }
  .terminal-home-theme .command-menu span { display: block; margin-top: 8px; color: var(--muted); font-size: 12.5px; line-height: 1.48; }
  .terminal-home-theme .command-panels,
  .terminal-home-theme .command-panels > div { min-width: 0; height: 100%; }
  .terminal-home-theme .command-panels > div[hidden] { display: none; }

  .terminal-home-theme .final-cta { padding: 122px 0 112px; border-top: 1px solid var(--hair); background: #13110f; }
  .terminal-home-theme .final-cta-inner { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .terminal-home-theme .final-cta-inner > p { max-width: 54ch; }
