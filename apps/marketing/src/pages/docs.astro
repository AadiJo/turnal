<script>
  interface AccordionState {
    animation: Animation;
    expanding: boolean;
  }

  const accordionStates = new WeakMap<HTMLDetailsElement, AccordionState>();
  const troubleshootingItems = document.querySelectorAll<HTMLDetailsElement>('.troubleshooting-list details');

  for (const item of troubleshootingItems) {
    const summary = item.querySelector<HTMLElement>('summary');
    if (!summary) continue;

    summary.addEventListener('click', (event) => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      event.preventDefault();

      const activeState = accordionStates.get(item);
      const expand = activeState ? !activeState.expanding : !item.open;
      const currentHeight = item.getBoundingClientRect().height;

      if (activeState) activeState.animation.cancel();
      item.style.height = `${currentHeight}px`;
      item.classList.add('is-animating');

      if (expand) item.open = true;

      const borderHeight = item.offsetHeight - item.clientHeight;
      const collapsedHeight = summary.getBoundingClientRect().height + borderHeight;
      const expandedHeight = item.scrollHeight + borderHeight;
      const targetHeight = expand ? expandedHeight : collapsedHeight;

      const animation = item.animate(
        { height: [`${currentHeight}px`, `${targetHeight}px`] },
        { duration: 240, easing: 'cubic-bezier(0.4, 0, 0.2, 1)' },
      );

      accordionStates.set(item, { animation, expanding: expand });
      animation.onfinish = () => {
        if (accordionStates.get(item)?.animation !== animation) return;
        item.open = expand;
        item.style.height = '';
        item.classList.remove('is-animating');
        accordionStates.delete(item);
      };
    });
  }
</script>
