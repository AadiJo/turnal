{
  "name": "@aadijo/turnal",
  "version": "0.0.2",
  "description": "Local-first CLI for recording AI coding agent history, file changes, diffs, and safe rollbacks.",
  "bin": {
    "turnal": "npm/turnal.js",
    "turnal-adapter-opencode": "npm/turnal-adapter-opencode.js",
    "turnal-adapter-gemini-cli": "npm/turnal-adapter-gemini-cli.js",
    "turnal-adapter-copilot-cli": "npm/turnal-adapter-copilot-cli.js"
  },
  "files": [
    "cmd/",
    "internal/",
    "sdk/",
    "npm/",
    "go.mod",
    "go.sum",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SECURITY.md",
    "docs/"
  ],
  "scripts": {
    "build": "npm run build:web && go build -o bin/turnal ./cmd/turnal",
    "build:web": "vite build",
    "check:web": "tsc --noEmit && npm run build:web && git diff --exit-code -- internal/viewer/web/dist",
    "dev:web": "vite",
    "build:npm-binaries": "npm run build:web && node scripts/build-npm-binaries.js",
    "test": "go test ./...",
    "test:postinstall": "node --test scripts/remove-powershell-shims.test.js",
    "test:installer": "sh scripts/test-install.sh",
    "test:installer:windows": "powershell -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/test-install.ps1",
    "build:release-archives": "node scripts/build-release-archives.js",
    "pack:dry-run": "npm pack --dry-run",
    "test:release-sbom": "node --test scripts/validate-release-sbom.test.js",
    "postinstall": "node npm/postinstall.js",
    "prepack": "npm run build:npm-binaries",
    "prepublishOnly": "go test ./..."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AadiJo/turnal.git"
  },
  "bugs": {
    "url": "https://github.com/AadiJo/turnal/issues"
  },
  "homepage": "https://github.com/AadiJo/turnal#readme",
  "keywords": [
    "agent",
    "cli",
    "git",
    "history",
    "rollback"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "preact": "^10.29.7"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  }
}
